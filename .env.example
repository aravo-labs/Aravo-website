# The CMS backend: public pages, docs, careers, the SDK access form.
NEXT_PUBLIC_API_URL=http://localhost:8010

# The tracking platform: everything under /dashboard, plus signup and login.
# A separate deployment on a separate Supabase project. Deliberately its own
# variable: one shared value would point half the app at the wrong service the
# moment either address changed.
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8020

# Supabase, for customer sign-in. The PLATFORM project, not the CMS one.
# Only the anon / publishable key belongs in a NEXT_PUBLIC_ variable - it is
# compiled into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the platform admin panel lives.
#
# Used for one thing: a member of staff who signs in here instead of there
# gets told so, with a way across. Optional - without it they still get the
# right explanation, just no link.
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:4800

# Whether a content backend is wired up.
#
# Off by default. The marketing pages have working defaults for everything the
# site settings carry, so the site stands up without one. Turn it on only when
# a content API is actually reachable: when it is not, the browser logs a
# failed request on every page load, and catching the error in code does not
# prevent that.
NEXT_PUBLIC_CMS_ENABLED=false
