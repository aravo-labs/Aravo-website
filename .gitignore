# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local working material only. Holds captures of the reference site used while
# working out spacing and type, which is not something to ship in a client
# repo - and 12MB of PNGs would sit in git history forever.
/_reference/

# Agent instruction files. `next dev` regenerates AGENTS.md on every run
# (node_modules/next/dist/server/lib/generate-agent-files.js), so deleting it
# is not enough on its own - ignored here so it stays out of the repo instead
# of reappearing as an uncommitted change every time the dev server starts.
AGENTS.md

# Local MCP server registrations. Machine-specific tooling, not part of the
# site - and the file names a Supabase project, which does not belong in a
# repo that may be shared.
.mcp.json
